<UserControl x:Class="RASTA.App.Views.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:selectors="clr-namespace:RASTA.App.Selectors"
             mc:Ignorable="d">
    <UserControl.Resources>

        <!-- Equatorial template -->
        <DataTemplate x:Key="EquatorialPointTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding RightAscensionHours, StringFormat=RA: {0:F2}h}" Margin="0 5 20 0"/>
                <TextBlock Text="{Binding DeclinationDeg, StringFormat=Dec: {0:F2}°}" Margin="0 5 0 0"/>
            </StackPanel>
        </DataTemplate>

        <!-- AltAz template -->
        <DataTemplate x:Key="AltAzPointTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding AzimuthDeg, StringFormat=Az: {0:F1}°}" Margin="0 10 20 0"/>
                <TextBlock Text="{Binding ElevationDeg, StringFormat=Alt: {0:F1}°}" Margin="0 5 0 0"/>
            </StackPanel>
        </DataTemplate>

        <!-- Template selector -->
        <selectors:TargetPointTemplateSelector x:Key="TargetPointSelector"
                                           EquatorialTemplate="{StaticResource EquatorialPointTemplate}"
                                           AltAzTemplate="{StaticResource AltAzPointTemplate}"/>

    </UserControl.Resources>


    <Grid Margin="10">
        <StackPanel>

            <TextBlock Text="Plan (Sweep Builder)"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0 0 0 20"/>

            <TextBlock Text="Target Range"
                       FontWeight="Bold"/>

            <StackPanel Orientation="Horizontal" Margin="0 10 0 10">

                <!-- RA/Dec -->
                <StackPanel Margin="0 0 20 0" 
                            Visibility="{Binding Settings.Mode,
                                Converter={StaticResource EquatorialVisibilityConverter}}">
                    <TextBlock Text="RA Start (hours)"/>
                    <TextBox Width="120"
                             Text="{Binding Range.RAStartHours}"/>
                </StackPanel>

                <StackPanel Margin="0 0 20 0"
                            Visibility="{Binding Settings.Mode,
                                Converter={StaticResource EquatorialVisibilityConverter}}">
                    <TextBlock Text="RA End (hours)"/>
                    <TextBox Width="120"
                             Text="{Binding Range.RAEndHours}"/>
                </StackPanel>

                <StackPanel Margin="0 0 20 0"
                            Visibility="{Binding Settings.Mode,
                                Converter={StaticResource EquatorialVisibilityConverter}}">
                    <TextBlock Text="Dec Start (deg)"/>
                    <TextBox Width="120"
                             Text="{Binding Range.DecStartDeg}"/>
                </StackPanel>

                <StackPanel Margin="0 0 20 0"
                            Visibility="{Binding Settings.Mode,
                                Converter={StaticResource EquatorialVisibilityConverter}}">
                    <TextBlock Text="Dec End (deg)"/>
                    <TextBox Width="120"
                             Text="{Binding Range.DecEndDeg}"/>
                </StackPanel>


                <!-- Azimuth/Altitude -->
                <StackPanel Margin="0 0 20 0" 
                            Visibility="{Binding Settings.Mode,
                                Converter={StaticResource AltAzVisibilityConverter}}">
                    <TextBlock Text="Azimuth Start (deg)"/>
                    <TextBox Width="120"
                             Text="{Binding Range.AzimuthStartDeg}"/>
                </StackPanel>

                <StackPanel Margin="0 0 20 0"
                            Visibility="{Binding Settings.Mode,
                                Converter={StaticResource AltAzVisibilityConverter}}">
                    <TextBlock Text="Azimuth End (deg)"/>
                    <TextBox Width="120"
                             Text="{Binding Range.AzimuthEndDeg}"/>
                </StackPanel>

                <StackPanel Margin="0 0 20 0"
                            Visibility="{Binding Settings.Mode,
                                Converter={StaticResource AltAzVisibilityConverter}}">
                    <TextBlock Text="Altitude Start (deg)"/>
                    <TextBox Width="120"
                             Text="{Binding Range.AltitudeStartDeg}"/>
                </StackPanel>

                <StackPanel Margin="0 0 20 0"
                            Visibility="{Binding Settings.Mode,
                                Converter={StaticResource AltAzVisibilityConverter}}">
                    <TextBlock Text="Altitude End (deg)"/>
                    <TextBox Width="120"
                             Text="{Binding Range.AltitudeEndDeg}"/>
                </StackPanel>


                <!-- Step size -->
                <StackPanel>
                    <TextBlock Text="Step Size (deg)"/>
                    <TextBox Width="120"
                             Text="{Binding Range.StepDeg}"/>
                </StackPanel>

            </StackPanel>

            <Button Content="Build Sweep"
                    Width="200"
                    Height="40"
                    Command="{Binding BuildSweepCommand}"/>

            <TextBlock Text="Planned Points:"
                       FontWeight="Bold"
                       Margin="0 20 0 5"/>

            <ItemsControl ItemsSource="{Binding PlannedPoints}"
              ItemTemplateSelector="{StaticResource TargetPointSelector}"/>




        </StackPanel>
    </Grid>
</UserControl>
