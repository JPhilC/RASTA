<UserControl x:Class="RASTA.App.Views.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RASTA.App.ViewModels"
             mc:Ignorable="d">

    <!-- The Plan view's primary content is now the sky map (a zenith-centered Alt/Az dome, same
         projection/reference geometry the Mosaic tab's Zenith Dome uses - see DomeProjector).
         The old numeric Range boxes and other plan fields moved into the modeless "Edit Plan
         Details" window (see OpenPlanEditorCommand/PlanEditorWindowService) - both are bound to
         this same PlanViewModel instance, so they stay in sync automatically. -->

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE: SKY MAP -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Plan" FontSize="24" FontWeight="Bold" Margin="0 0 0 10"/>

            <!-- Toolbar -->
            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 8">
                <Button Content="Edit Plan Details..." Command="{Binding OpenPlanEditorCommand}" Padding="8,3" Margin="0,0,16,4"/>

                <!-- Name + Save right here on the map, so drawing a region and saving it don't
                     require jumping to the separate Edit Plan Details window. SaveStatusText
                     gives explicit feedback either way (success or failure) rather than a save
                     that silently does (or doesn't) do anything. -->
                <TextBlock Text="Plan Name" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Width="150" VerticalAlignment="Center" Margin="0,0,4,4" Text="{Binding FriendlyName, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Save Plan" Command="{Binding SavePlanCommand}" Padding="8,2" Margin="0,0,4,4"/>
                <TextBlock Text="{Binding SaveStatusText}" VerticalAlignment="Center" FontStyle="Italic" Margin="0,0,16,4"/>

                <TextBlock Text="Map Time (UTC)" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Width="140" VerticalAlignment="Center" Margin="0,0,4,4"
                         Text="{Binding MapTimeUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                <Button Content="Now" Command="{Binding SetMapTimeNowCommand}" Padding="8,2" Margin="0,0,16,4"/>

                <TextBlock Text="Grid:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <RadioButton Content="Alt/Az" GroupName="MapGridMode" VerticalAlignment="Center" Margin="0,0,10,4"
                             IsChecked="{Binding MapGridMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=AltAz}"/>
                <RadioButton Content="RA/Dec" GroupName="MapGridMode" VerticalAlignment="Center" Margin="0,0,16,4"
                             IsChecked="{Binding MapGridMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Equatorial}"/>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding PlanType, Converter={StaticResource PlanTypeToVisibilityConverter}, ConverterParameter=Equatorial}"
                            Margin="0,0,16,4">
                    <Button Content="Draw Region" Command="{Binding StartDrawRegionCommand}" Padding="8,3"
                            Visibility="{Binding IsDrawingRegion, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    <Button Content="Finish Region" Command="{Binding FinishRegionCommand}" Padding="8,3" Margin="4,0,0,0"
                            Visibility="{Binding IsDrawingRegion, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="Clear Region" Command="{Binding ClearRegionCommand}" Padding="8,3" Margin="4,0,0,0"
                            Visibility="{Binding CanClearRegion, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <TextBlock Text="Points:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <RadioButton Content="Show All" GroupName="PointDisplayMode" VerticalAlignment="Center" Margin="0,0,10,4"
                             IsChecked="{Binding PointDisplayMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All}"/>
                <RadioButton Content="Animate" GroupName="PointDisplayMode" VerticalAlignment="Center" Margin="0,0,10,4"
                             IsChecked="{Binding PointDisplayMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Animate}"/>
                <Button Content="▶" Command="{Binding PlayAnimationCommand}" Padding="8,2" Margin="0,0,2,4" ToolTip="Play"/>
                <Button Content="⏸" Command="{Binding PauseAnimationCommand}" Padding="8,2" Margin="0,0,2,4" ToolTip="Pause"/>
                <Button Content="⏭" Command="{Binding StepAnimationCommand}" Padding="8,2" Margin="0,0,2,4" ToolTip="Step"/>
                <Button Content="⏮" Command="{Binding ResetAnimationCommand}" Padding="8,2" Margin="0,0,10,4" ToolTip="Reset"/>
                <TextBlock Text="Speed (s/point)" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Slider Width="100" Minimum="0.1" Maximum="2" Value="{Binding AnimationSpeedSecondsPerPoint}" VerticalAlignment="Center" Margin="0,0,0,4"/>
            </WrapPanel>

            <!-- Dome map -->
            <Viewbox Grid.Row="2" Stretch="Uniform">
                <Canvas x:Name="MapCanvas"
                        Width="{Binding MapDisplay.CanvasSize}" Height="{Binding MapDisplay.CanvasSize}"
                        Background="Transparent"
                        MouseMove="MapCanvas_MouseMove"
                        MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"
                        PreviewMouseRightButtonDown="MapCanvas_PreviewMouseRightButtonDown">

                    <Canvas.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Slew &amp; Capture Here" Command="{Binding CaptureHereCommand}"/>
                        </ContextMenu>
                    </Canvas.ContextMenu>

                    <!-- Analytic Milky Way background - see MilkyWayBackgroundBuilder. -->
                    <Image Source="{Binding MapDisplay.Background}"
                           Width="{Binding MapDisplay.CanvasSize}" Height="{Binding MapDisplay.CanvasSize}"
                           Stretch="Fill" RenderOptions.BitmapScalingMode="Linear" IsHitTestVisible="False"/>

                    <!-- Altitude rings -->
                    <ItemsControl ItemsSource="{Binding MapDisplay.AltitudeRings}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="{Binding Diameter}" Height="{Binding Diameter}"
                                         Stroke="#40808080" StrokeThickness="1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Azimuth spokes -->
                    <ItemsControl ItemsSource="{Binding MapDisplay.AzimuthSpokes}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                      Stroke="#30808080" StrokeThickness="1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- RA/Dec meridian/parallel grid - only populated when MapGridMode is
                         Equatorial (see PlanViewModel.RefreshVisiblePoints); empty, and so
                         invisible, in Alt/Az mode. -->
                    <ItemsControl ItemsSource="{Binding MapDisplay.EquatorialGridLines}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Polyline Points="{Binding}" Stroke="#40808080" StrokeThickness="1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Compass labels (Alt/Az mode) or RA/Dec labels (Equatorial mode) - same
                         MapDisplay.CompassLabels binding either way, see RefreshVisiblePoints. -->
                    <ItemsControl ItemsSource="{Binding MapDisplay.CompassLabels}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" FontSize="11" FontWeight="Bold" Margin="-10,-8,0,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- In-progress region polyline -->
                    <Polyline Points="{Binding MapDisplay.RegionPolyline}" Stroke="Yellow" StrokeThickness="2"
                              StrokeDashArray="4 2" IsHitTestVisible="False"/>

                    <!-- Capture points (sequence-coloured; the current animated point is enlarged) -->
                    <ItemsControl ItemsSource="{Binding MapDisplay.Points}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="9" Height="9" Margin="-4.5,-4.5,0,0"
                                         Stroke="Black" StrokeThickness="0.5" ToolTip="{Binding Tooltip}"
                                         IsHitTestVisible="False">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding Color}"/>
                                    </Ellipse.Fill>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Width" Value="16"/>
                                                    <Setter Property="Height" Value="16"/>
                                                    <Setter Property="Margin" Value="-8,-8,0,0"/>
                                                    <Setter Property="Stroke" Value="White"/>
                                                    <Setter Property="StrokeThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Viewbox>

            <StackPanel Grid.Row="3" Margin="0 6 0 0">
                <TextBlock Text="{Binding HoverReadoutText}" FontFamily="Consolas"/>
                <TextBlock Text="{Binding MapDisplay.StatusText}" FontStyle="Italic" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- RIGHT SIDE: SAVED PLANS -->
        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Saved Plans"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0 0 0 10"/>

                <ListView ItemsSource="{Binding SavedPlans}"
                      SelectedItem="{Binding SelectedPlan}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FriendlyName}" FontWeight="Bold" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding PlanType}" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Range.GeometryMode}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                    <Button Content="Load"
                        Command="{Binding LoadPlanCommand}"
                        CommandParameter="{Binding SelectedPlan}"
                        Width="80"/>

                    <Button Content="Copy"
                        Command="{Binding CopyPlanCommand}"
                        CommandParameter="{Binding SelectedPlan}"
                        Width="80" Margin="10 0 0 0"/>

                    <Button Content="Delete"
                        Command="{Binding DeletePlanCommand}"
                        CommandParameter="{Binding SelectedPlan}"
                        Width="80" Margin="10 0 0 0"/>
                </StackPanel>

                <Button Content="New Plan"
                    Command="{Binding NewPlanCommand}"
                    Width="200"
                    Margin="0 20 0 0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
