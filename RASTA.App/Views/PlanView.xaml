<UserControl x:Class="RASTA.App.Views.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:RASTA.App.Helpers"
             xmlns:converters="clr-namespace:RASTA.App.Converters"
             xmlns:selectors="clr-namespace:RASTA.App.Selectors"
             xmlns:controls="clr-namespace:RASTA.App.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>

        <!-- Sweep point templates -->
        <DataTemplate x:Key="EquatorialPointTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding RightAscensionHours, StringFormat=RA: {0:F2}h}" Margin="0 5 20 0"/>
                <TextBlock Text="{Binding DeclinationDeg, StringFormat=Dec: {0:F2}°}" Margin="0 5 0 0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AltAzPointTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding AzimuthDeg, StringFormat=Az: {0:F1}°}" Margin="0 10 20 0"/>
                <TextBlock Text="{Binding ElevationDeg, StringFormat=Alt: {0:F1}°}" Margin="0 5 0 0"/>
            </StackPanel>
        </DataTemplate>

        <selectors:TargetPointTemplateSelector
            x:Key="TargetPointSelector"
            EquatorialTemplate="{StaticResource EquatorialPointTemplate}"
            AltAzTemplate="{StaticResource AltAzPointTemplate}" />

    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE: PLAN EDITOR -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Plan Editor"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0 0 0 20"/>

                <!-- Friendly Name -->
                <StackPanel Margin="0 10 0 0">
                    <TextBlock Text="Friendly Name" FontWeight="Bold"/>
                    <TextBox Text="{Binding FriendlyName}" Width="300" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Plan Type -->
                <StackPanel Margin="0 10 0 0">
                    <TextBlock Text="Plan Type" FontWeight="Bold"/>
                    <ComboBox Width="200" HorizontalAlignment="Left"
                      SelectedItem="{Binding PlanType}"
                      ItemsSource="{Binding Source={x:Static helpers:PlanTypeEnum.Values}}"/>
                </StackPanel>
                <!-- SWEEP GEOMETRY (Equatorial or AltAz) -->
                <StackPanel Visibility="{Binding PlanType, Converter={StaticResource EquatorialOrAltAzVisibilityConverter}}" 
                            Margin="0 10 0 0">

                    <TextBlock Text="Sweep Geometry" FontWeight="Bold"/>


                    <StackPanel Orientation="Horizontal" 
                                Margin="0 5 0 0"
                                Visibility="{Binding PlanType, Converter={StaticResource PlanTypeToVisibilityConverter}, ConverterParameter=Equatorial}">

                        <!-- RA/Dec -->
                        <StackPanel Margin="0 5 20 0">
                            <TextBlock Text="RA Start (hours)"/>
                            <TextBox Width="120" Text="{Binding Range.RAStartHours}"/>
                        </StackPanel>

                        <StackPanel Margin="0 5 20 0">
                            <TextBlock Text="RA End (hours)"/>
                            <TextBox Width="120" Text="{Binding Range.RAEndHours}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" 
                                Margin="0 5 0 0"
                                Visibility="{Binding PlanType, Converter={StaticResource PlanTypeToVisibilityConverter}, ConverterParameter=Equatorial}">
                        <StackPanel Margin="0 0 20 0">
                            <TextBlock Text="Dec Start (deg)"/>
                            <TextBox Width="120" Text="{Binding Range.DecStartDeg}"/>
                        </StackPanel>

                        <StackPanel Margin="0 0 20 0">
                            <TextBlock Text="Dec End (deg)"/>
                            <TextBox Width="120" Text="{Binding Range.DecEndDeg}"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Az/El -->
                    <StackPanel Orientation="Horizontal" Margin="0 5 0 0"
                                Visibility="{Binding PlanType, Converter={StaticResource PlanTypeToVisibilityConverter}, ConverterParameter=AltAz}">

                        <StackPanel Margin="0 0 20 0">
                            <TextBlock Text="Az Start (deg)"/>
                            <TextBox Width="120" Text="{Binding Range.AzimuthStartDeg}"/>
                        </StackPanel>

                        <StackPanel Margin="0 0 20 0">
                            <TextBlock Text="Az End (deg)"/>
                            <TextBox Width="120" Text="{Binding Range.AzimuthEndDeg}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 5 0 0"
                                Visibility="{Binding PlanType, Converter={StaticResource PlanTypeToVisibilityConverter}, ConverterParameter=AltAz}">
                        <StackPanel Margin="0 0 20 0">
                            <TextBlock Text="El Start (deg)"/>
                            <TextBox Width="120" Text="{Binding Range.AltitudeStartDeg}"/>
                        </StackPanel>

                        <StackPanel Margin="0 0 20 0">
                            <TextBlock Text="El End (deg)"/>
                            <TextBox Width="120" Text="{Binding Range.AltitudeEndDeg}"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Step size -->
                    <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                        <StackPanel Margin="0 0 20 0">
                            <TextBlock Text="Step Size (Deg)"/>
                            <TextBox Width="120" Text="{Binding Range.StepDeg}"/>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>

                <!--<Button Content="Build Sweep"
                        Width="200"
                        Height="40"
                        Command="{Binding BuildSweepCommand}"
                        Margin="0 20 0 20"/>-->

                <!-- DRIFT SCAN -->
                <StackPanel Margin="0 20 0 0 " 
                Visibility="{Binding PlanType, Converter={StaticResource DriftVisibilityConverter}}">
                    <TextBlock Text="Drift Scan Parameters" FontWeight="Bold"/>

                    <StackPanel Orientation="Horizontal" Margin="0 5 0 10">
                        <StackPanel Margin="0 5 20 0">
                            <TextBlock Text="Declination (deg)"/>
                            <TextBox Width="120" Text="{Binding DriftDeclinationDeg}"/>
                        </StackPanel>

                        <StackPanel Margin="0 5 20 0">
                            <TextBlock Text="Duration (min)"/>
                            <TextBox Width="120" Text="{Binding DriftDurationMinutes}"/>
                        </StackPanel>

                        <StackPanel Margin="0 5 20 0">
                            <TextBlock Text="Cadence (sec)"/>
                            <TextBox Width="120" Text="{Binding DriftCadenceSeconds}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- CAPTURE PARAMETERS -->
                <TextBlock Text="Capture Parameters" FontWeight="Bold" Margin="0 20 0 0"/>
                <StackPanel Orientation="Vertical" Margin="0 0 0 10">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0 5 20 0">
                            <TextBlock Text="Dwell Time (sec)"/>
                            <TextBox Width="120" Text="{Binding DwellSeconds}"/>
                        </StackPanel>
                        <StackPanel Margin="0 5 20 0">
                            <TextBlock Text="Files/Point"/>
                            <TextBox Width="120" Text="{Binding FilesPerPoint}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0 5 20 0">
                            <TextBlock Text="Sample Rate (Hz)"/>
                            <controls:FrequencyEntryBox Grid.Row="1" Grid.Column="1" 
                                        FrequencyHz="{Binding SampleRate,
                                        UpdateSourceTrigger=PropertyChanged,
                                        ValidatesOnDataErrors=True}"
                                         Width="120" HorizontalAlignment="Left"/>

                        </StackPanel>

                        <StackPanel Margin="0 5 20 0">
                            <TextBlock Text="Center Frequency (Hz)"/>
                            <controls:FrequencyEntryBox Grid.Row="1" Grid.Column="1" 
                                        FrequencyHz="{Binding CenterFrequency,
                                        UpdateSourceTrigger=PropertyChanged,
                                        ValidatesOnDataErrors=True}"
                                         Width="120" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,5,20,0">
                            <TextBlock Text="FFT Bins"/>
                            <TextBox Width="120" Text="{Binding FftBins}"/>
                        </StackPanel>

                        <StackPanel Margin="0 5 20 0">
                            <TextBlock Text="Integrations"/>
                            <TextBox Width="120" Text="{Binding Integrations}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- TELESCOPE PARAMETERS -->
                <TextBlock Text="Telescope Parameters" FontWeight="Bold" Margin="0 20 0 0"/>

                <StackPanel Orientation="Horizontal" Margin="0 5 0 10">

                    <StackPanel Margin="0 5 20 0">
                        <TextBlock Text="Settle Time (sec)"/>
                        <TextBox Width="120" Text="{Binding SettleTimeSeconds}"/>
                    </StackPanel>

                    <StackPanel Margin="0 5 20 0">
                        <TextBlock Text="Tracking Enabled"/>
                        <CheckBox IsChecked="{Binding TrackingEnabled}"/>
                    </StackPanel>

                    <StackPanel Margin="0 5 20 0">
                        <TextBlock Text="Home When Complete"/>
                        <CheckBox IsChecked="{Binding GoToHomeAfterCapture}"/>
                    </StackPanel>

                </StackPanel>

                <!-- OUTPUT PARAMETERS -->

                <StackPanel Orientation="Horizontal" Margin="0 5 0 10">

                    <StackPanel Margin="0 5 20 0"/>

                    <StackPanel Margin="0 5 20 0"/>

                </StackPanel>

                <!-- SAVE PLAN -->
                <Button Content="Save Plan"
                    Width="200"
                    Height="40"
                    Command="{Binding SavePlanCommand}"
                    Margin="0 20 0 0"/>

            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT SIDE: SAVED PLANS -->
        <ScrollViewer Grid.Column="1" 
                      Margin="20 0 0 0" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <StackPanel >

                <TextBlock Text="Saved Plans"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0 0 0 10"/>

                <ListView ItemsSource="{Binding SavedPlans}"
                      SelectedItem="{Binding SelectedPlan}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding FriendlyName}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding PlanType}"/>
                                <TextBlock Text="{Binding Points.Count, StringFormat=Points: {0}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                    <Button Content="Load"
                        Command="{Binding LoadPlanCommand}"
                        CommandParameter="{Binding SelectedPlan}"
                        Width="80"/>

                    <Button Content="Copy"
                        Command="{Binding CopyPlanCommand}"
                        CommandParameter="{Binding SelectedPlan}"
                        Width="80" Margin="10 0 0 0"/>

                    <Button Content="Delete"
                        Command="{Binding DeletePlanCommand}"
                        CommandParameter="{Binding SelectedPlan}"
                        Width="80" Margin="10 0 0 0"/>
                </StackPanel>

                <Button Content="New Plan"
                    Command="{Binding NewPlanCommand}"
                    Width="200"
                    Margin="0 20 0 0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
