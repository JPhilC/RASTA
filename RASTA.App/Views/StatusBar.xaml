<UserControl x:Class="RASTA.App.Views.StatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="#2D2D2D" Padding="8">
        <Grid>

            <!-- Responsive 3‑column layout -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <!-- separator -->
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <!-- separator -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========================= -->
            <!--  Telescope Section        -->
            <!-- ========================= -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="10,0">

                <!-- Connection dot -->
                <Ellipse Width="10" Height="10"
                         Margin="0,0,8,0"
                         Fill="{Binding TelescopeConnected, Converter={StaticResource BooleanToBrushConverter}}"
                         VerticalAlignment="Center"/>

                <TextBlock Text="Telescope:"
                           Foreground="LightGray"
                           FontWeight="Bold"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"/>

                <TextBlock Text="{Binding TelescopeStatus}"
                           Foreground="White"
                           Margin="0,0,20,0"
                           VerticalAlignment="Center"/>

                <TextBlock Text="{Binding CoordinateStatus}"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Separator -->
            <Border Grid.Column="1"
                    Width="1"
                    Background="#444"
                    Margin="10,0"/>

            <!-- ========================= -->
            <!--  SDR Section              -->
            <!-- ========================= -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="10,0">

                <!-- Connection dot -->
                <Ellipse Width="10" Height="10"
                         Margin="0,0,8,0"
                         Fill="{Binding SdrConnected, Converter={StaticResource BooleanToBrushConverter}}"
                         VerticalAlignment="Center"/>

                <TextBlock Text="SDR:"
                           Foreground="LightGray"
                           FontWeight="Bold"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"/>

                <TextBlock Text="{Binding SdrStatus}"
                           Foreground="White"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"/>
                
                <TextBlock Text="{Binding CalibratedGain}"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Separator -->
            <Border Grid.Column="3"
                    Width="1"
                    Background="#444"
                    Margin="10,0"/>

            <!-- ========================= -->
            <!--  Observing Section        -->
            <!-- ========================= -->
            <StackPanel Grid.Column="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="10,0">

                
                <TextBlock Text="Capture:"
                           Foreground="LightGray"
                           FontWeight="Bold"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"/>

                <Grid>
                    <ProgressBar
                        Minimum="0"
                        Maximum="1"
                        Value="{Binding CaptureProgress}"
                        Visibility="{Binding IsCaptureInProgress, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Height="14" Width="100"
                        Margin="10,0"
                        VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CaptureStatus}"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
