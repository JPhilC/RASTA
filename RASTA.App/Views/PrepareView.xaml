<UserControl x:Class="RASTA.App.Views.PrepareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wpf="clr-namespace:System.Windows;assembly=PresentationCore"
             mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================= -->
        <!--  TELESCOPE CONNECTION     -->
        <!-- ========================= -->
        <StackPanel Grid.Column="0" Grid.Row="0">
            <TextBlock Text="Telescope"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0 0 0 20"/>

            <Button Content="Connect"
                    Width="200"
                    Height="40"
                    Command="{Binding ConnectTelescopeCommand}"
                    Visibility="{Binding IsConnectedMount,
                                         Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

            <Button Content="Disconnect"
                    Width="200"
                    Height="40"
                    Command="{Binding DisconnectTelescopeCommand}"
                    Visibility="{Binding IsConnectedMount,
                                         Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- ========================= -->
        <!--  SITE LOCATION SETTINGS   -->
        <!-- ========================= -->
        <Grid Grid.Column="1" Grid.Row="0"
              Visibility="{Binding IsConnectedMount,
                                   Converter={StaticResource BooleanToVisibilityConverter},
                                   ConverterParameter={x:Static wpf:Visibility.Collapsed}}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                       Text="Mount Details"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0 0 0 20"/>

            <TextBlock Grid.Column="0" Grid.Row="1" Text="Latitude (deg)"/>
            <TextBox Grid.Column="1" Grid.Row="1" Width="100"
                     Text="{Binding SiteLatitudeDeg}"
                     Margin="5,0,0,5"/>

            <TextBlock Grid.Column="0" Grid.Row="2" Text="Longitude (deg)"/>
            <TextBox Grid.Column="1" Grid.Row="2" Width="100"
                     Text="{Binding SiteLongitudeDeg}"
                     Margin="5,0,0,5"/>

            <TextBlock Grid.Column="0" Grid.Row="3" Text="Elevation (m)"/>
            <TextBox Grid.Column="1" Grid.Row="3" Width="100"
                     Text="{Binding SiteElevationM}"
                     Margin="5,0,0,5"/>
            <TextBlock Grid.Column="0" Grid.Row="4" Text="Slew Rate (deg/sec)"/>
            <TextBox Grid.Column="1" Grid.Row="4" Width="100"
                     Text="{Binding SlewRateDegPerSec}"
                     Margin="5,0,0,5"/>
            <TextBlock Grid.Column="0" Grid.Row="5" Text="Horizon Limit (deg)"/>
            <TextBox Grid.Column="1" Grid.Row="5" Width="100"
                     Text="{Binding HorizonLimitDeg}"
                     Margin="5,0,0,5"/>
        </Grid>

        <!-- ========================= -->
        <!--  CALIBRATION PANEL        -->
        <!-- ========================= -->
        <StackPanel Grid.Column="0" Grid.Row="1">
            <TextBlock Text="Calibration"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0 0 0 20"/>

            <!-- Calibration Settings -->
            <StackPanel Orientation="Vertical">

                <TextBlock Text="Calibration Frequency (Hz)" />
                <TextBox Text="{Binding CalibrationFrequencyHz,
                                        UpdateSourceTrigger=PropertyChanged,
                                        ValidatesOnDataErrors=True}"
                         Width="200"
                         Margin="0 0 0 10"
                         IsEnabled="{Binding IsCalibrationRunning, Converter={StaticResource BooleanInverterConverter}}"/>

                <TextBlock Text="Sample Rate (Hz)" />
                <TextBox Text="{Binding SampleRateHz,
                                        UpdateSourceTrigger=PropertyChanged,
                                        ValidatesOnDataErrors=True}"
                         Width="200"
                         Margin="0 0 0 10"
                         IsEnabled="{Binding IsCalibrationRunning, Converter={StaticResource BooleanInverterConverter}}"/>

                <TextBlock Text="FFT Size" />
                <TextBox Text="{Binding FftSize,
                                        UpdateSourceTrigger=PropertyChanged,
                                        ValidatesOnDataErrors=True}"
                         Width="200"
                         Margin="0 0 0 10"
                         IsEnabled="{Binding IsCalibrationRunning, Converter={StaticResource BooleanInverterConverter}}"/>

                <TextBlock Text="Dwell Time (seconds)" />
                <TextBox Text="{Binding CalibrationDwellSeconds,
                                        UpdateSourceTrigger=PropertyChanged,
                                        ValidatesOnDataErrors=True}"
                         Width="200"
                         Margin="0 0 0 20"
                         IsEnabled="{Binding IsCalibrationRunning, Converter={StaticResource BooleanInverterConverter}}"/>
            </StackPanel>

            <!-- Calibrate Button -->
            <Button Content="Calibrate"
                    Width="200"
                    Height="40"
                    Command="{Binding RunCalibrationCommand}"
                    Visibility="{Binding IsCalibrationRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

            <!-- Cancel Calibrate Button -->
            <Button Content="Cancel"
                    Width="200"
                    Height="40"
                    Command="{Binding CancelCalibrationCommand}"
                    Visibility="{Binding IsCalibrationRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Calibration Status -->
            <TextBlock Text="Calibration Status:"
                       FontWeight="Bold"
                       Margin="0 20 0 5"/>

            <TextBlock Text="{Binding StatusMessage}" />

            <!-- Progress Bar -->
            <ProgressBar Minimum="0"
                         Maximum="1"
                         Value="{Binding ProgressValue}"
                         Height="20"
                         Margin="0 10 0 0"/>
        </StackPanel>

        <!-- ========================= -->
        <!--  SDR STATUS PANEL         -->
        <!-- ========================= -->
        <StackPanel Grid.Column="1" Grid.Row="1">
            <TextBlock Text="SDR Status"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0 0 0 20"/>

            <TextBlock Text="{Binding IsConnectedSdr,
                                      StringFormat=SDR Connected: {0}}"
                       FontSize="16"
                       FontWeight="SemiBold"/>

            <TextBlock Text="{Binding Calibration.GainDb,
                                      StringFormat=Selected Gain: {0} dB}"
                       Margin="0 10 0 0"
                       Visibility="{Binding IsCalibrated,
                                            Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

    </Grid>
</UserControl>
