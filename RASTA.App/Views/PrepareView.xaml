<UserControl x:Class="RASTA.App.Views.PrepareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="10">
        <StackPanel>

            <TextBlock Text="Prepare (Calibration)"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0 0 0 20"/>

            <Button Content="Build Calibration"
                    Width="200"
                    Height="40"
                    Command="{Binding BuildCalibrationCommand}"/>

            <TextBlock Text="Calibration Status:"
                       FontWeight="Bold"
                       Margin="0 20 0 5"/>

            <TextBlock Text="{Binding IsCalibrated, StringFormat=Calibrated: {0}}"/>
        </StackPanel>
    </Grid>
</UserControl>
