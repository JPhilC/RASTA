<UserControl x:Class="RASTA.App.Views.PrepareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wpf="clr-namespace:System.Windows;assembly=PresentationCore"
             xmlns:controls="clr-namespace:RASTA.App.Controls"
             mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================= -->
        <!--  TELESCOPE CONNECTION     -->
        <!-- ========================= -->
        <TextBlock Grid.Column="0" Grid.Row="0"
                    Text="Telescope"
                       FontSize="24"
                       FontWeight="Bold"/>
        
        <StackPanel Grid.Column="0" Grid.Row="2">

            <Button Content="Connect"
                    Width="180"
                    Height="40"
                    HorizontalAlignment="Left"
                    Command="{Binding ConnectTelescopeCommand}"
                    Visibility="{Binding IsConnectedMount,
                                         Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

            <Button Content="Disconnect"
                    Width="180"
                    Height="40"
                    HorizontalAlignment="Left"
                    Command="{Binding DisconnectTelescopeCommand}"
                    Visibility="{Binding IsConnectedMount,
                                         Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- ========================= -->
        <!--  SITE LOCATION SETTINGS   -->
        <!-- ========================= -->
        <TextBlock Grid.Column="1" Grid.Row="0"
                       Text="Mount Details"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0 0 0 20"/>

        <Grid Grid.Column="1" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <TextBlock Grid.Column="0" Grid.Row="1" Text="Latitude (deg)"/>
            <TextBox Grid.Column="1" Grid.Row="1" Width="100"
                     Text="{Binding SiteLatitudeDeg}"
                     Margin="5,0,0,5"/>

            <TextBlock Grid.Column="0" Grid.Row="2" Text="Longitude (deg)"/>
            <TextBox Grid.Column="1" Grid.Row="2" Width="100"
                     Text="{Binding SiteLongitudeDeg}"
                     Margin="5,0,0,5"/>

            <TextBlock Grid.Column="0" Grid.Row="3" Text="Elevation (m)"/>
            <TextBox Grid.Column="1" Grid.Row="3" Width="100"
                     Text="{Binding SiteElevationM}"
                     Margin="5,0,0,5"/>
            <TextBlock Grid.Column="0" Grid.Row="4" Text="Slew Rate (deg/sec)"/>
            <TextBox Grid.Column="1" Grid.Row="4" Width="100"
                     Text="{Binding SlewRateDegPerSec}"
                     Margin="5,0,0,5"/>
            <TextBlock Grid.Column="0" Grid.Row="5" Text="Horizon Limit (deg)"/>
            <TextBox Grid.Column="1" Grid.Row="5" Width="100"
                     Text="{Binding HorizonLimitDeg}"
                     Margin="5,0,0,5"/>
        </Grid>

        <!-- ========================= -->
        <!--  CALIBRATION PANEL        -->
        <!-- ========================= -->
        <TextBlock Grid.Column="0" Grid.Row="4"
                Text="Calibration"
                       FontSize="24"
                       FontWeight="Bold"/>

        <TextBlock Grid.Column="1" Grid.Row="4"
        Text="Calibration Settings"
               FontSize="24"
               FontWeight="Bold"/>

        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="6"
                    Text="Connect the telescope to capture a baseline (it needs to slew to a cold-sky position)."
                       Foreground="Gray" Margin="5,5,0,0" TextWrapping="Wrap"
                       Visibility="{Binding IsConnectedMount, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

        <!-- Three independent calibration steps - see PrepareViewModel for why -->
        <StackPanel Grid.Column="0" Grid.Row="8" 
                        Orientation="Vertical">

            <!-- 1. Load Last Calibration -->

            <Button Content="Load Last Calibration"
                        Width="180" Height="40" Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                        Command="{Binding LoadLastCalibrationCommand}"/>

            <!-- 2. Calibrate Device Gain -->
            <Button Content="Calibrate Device Gain"
                        Width="180" Height="40" Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                        Command="{Binding CalibrateGainCommand}"/>

            <!-- 3. Capture Baseline -->
            <Button Content="Capture Baseline"
                        Width="180" Height="40"  Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding CaptureBaselineCommand}"/>
        </StackPanel>

        <!-- Cancel Button - shown in place of the three above while any of them runs -->
        <Button Grid.Row="8" Grid.Column="0" Content="Cancel"
                    Width="180" 
                    Height="40"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding CancelCalibrationCommand}"
                    Visibility="{Binding IsCalibrationRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Hint when Capture Baseline can't be run because the mount isn't connected -->


        <Grid Grid.Column="1" Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- ========================= -->
            <!--  CALIBRATION SETTINGS   -->
            <!-- ========================= -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                Text="Calibration Frequency (Hz)"/>
            <controls:FrequencyEntryBox Grid.Row="1" Grid.Column="1"
                                        FrequencyHz="{Binding CalibrationFrequencyHz,
                                        UpdateSourceTrigger=PropertyChanged,
                                        ValidatesOnDataErrors=True}"
                         Width="120" HorizontalAlignment="Left" Margin="5,0,0,5"
                         IsEnabled="{Binding IsCalibrationRunning, Converter={StaticResource BooleanInverterConverter}}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Sample Rate (Hz)"/>
            <controls:FrequencyEntryBox Grid.Row="2" Grid.Column="1"
                                        FrequencyHz="{Binding SampleRateHz,
                                        UpdateSourceTrigger=PropertyChanged,
                                        ValidatesOnDataErrors=True}"
                         Width="120" HorizontalAlignment="Left" Margin="5,0,0,5"
                         IsEnabled="{Binding IsCalibrationRunning, Converter={StaticResource BooleanInverterConverter}}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="FFT Size"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FftSize,
                                        UpdateSourceTrigger=PropertyChanged,
                                        ValidatesOnDataErrors=True}"
                         Width="75" Margin="5,0,0,5"
                         IsEnabled="{Binding IsCalibrationRunning, Converter={StaticResource BooleanInverterConverter}}"/>


            <TextBlock Grid.Row="4" Grid.Column="0" Text="Gain Dwell Time (seconds)" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding GainDwellSeconds,
                                        UpdateSourceTrigger=PropertyChanged,
                                        ValidatesOnDataErrors=True}"
                         Width="50" Margin="5,0,0,5"
                         IsEnabled="{Binding IsCalibrationRunning, Converter={StaticResource BooleanInverterConverter}}"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Baseline Dwell Time (seconds)" />
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding BaselineDwellSeconds,
                                        UpdateSourceTrigger=PropertyChanged,
                                        ValidatesOnDataErrors=True}"
                         Width="50" Margin="5,0,0,5"
                         IsEnabled="{Binding IsCalibrationRunning, Converter={StaticResource BooleanInverterConverter}}"/>

        </Grid>





    </Grid>
</UserControl>
