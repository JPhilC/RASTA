<UserControl x:Class="RASTA.App.Views.ObserveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:RASTA.App.Views"
             mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <TextBlock Text="Friendly Name" FontWeight="Bold" Margin="0,0,5,0"/>
            <TextBox Text="{Binding PlanName, Mode=OneWay}" Width="300" HorizontalAlignment="Left" IsReadOnly="True" Margin="0,0,5,0"/>
            <Button Content="Begin Sweep" Width="100" Height="30" 
                    Command="{Binding CaptureSweepCommand}" HorizontalAlignment="Right"
                    Visibility="{Binding CanCaptureSweep, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Content="Cancel Sweep" Width="100" Height="30" 
                    Command="{Binding CancelSweepCommand}" HorizontalAlignment="Right"
                    Visibility="{Binding IsSweepCaptureRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Content="Begin Drift" Width="100" Height="30" 
                    Command="{Binding CaptureDriftCommand}" HorizontalAlignment="Right"
                    Visibility="{Binding CanDriftCapture, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Content="Cancel Drift" Width="100" Height="30" 
                    Command="{Binding CancelDriftCommand}" HorizontalAlignment="Right"
                    Visibility="{Binding IsDriftCaptureRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
        <views:SpectrumView Grid.Row="1" Margin="0,10,0,0" 
                            DataContext="{Binding SpectrumVm}"/>
    </Grid>
</UserControl>
