<UserControl x:Class="RASTA.App.Views.MosaicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:RASTA.App.Views"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="9"
                   Text="Mosaic (multi-capture)"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Folder / baseline row -->
        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                   Text="Session Folder" FontWeight="Bold"/>
        <TextBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="9" MinWidth="300"
                 VerticalAlignment="Center"
                 Text="{Binding CaptureFolder, Mode=OneWay}" IsReadOnly="True"
                 HorizontalAlignment="Left" Margin="0,0,5,0"/>
        <Button Grid.Row="2" Grid.Column="12"
                Content="Select Folder…" Command="{Binding SelectFolderCommand}"
                Padding="10,4" Width="160"/>

        <!-- Baseline row is only meaningful for a RASTA FITS session - not shown at all for a
             LAB Survey (or empty/unrecognised) folder, see MosaicViewModel.IsLabSurveySource. -->
        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"
                   Text="Baseline File" FontWeight="Bold"
                   Visibility="{Binding IsLabSurveySource, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
        <TextBox Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="9" MinWidth="300"
                 VerticalAlignment="Center"
                 Text="{Binding BaselineFile, Mode=OneWay}" IsReadOnly="True"
                 HorizontalAlignment="Left" Margin="0,0,5,0"
                 Visibility="{Binding IsLabSurveySource, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
        <Button Grid.Row="4" Grid.Column="12"
                Content="Select Baseline FIT" Command="{Binding SelectBaselineFileCommand}"
                Visibility="{Binding ShowSelectBaselineButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                Padding="10,4" Width="160"/>
        <Button Grid.Row="4" Grid.Column="12"
                Content="Clear Baseline FIT" Command="{Binding ClearBaselineFileCommand}"
                Visibility="{Binding BaselineAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                Padding="10,4" Width="160"/>

        <!-- Detected data-source indicator - set when Select Folder is clicked (a cheap
             extension/signature sniff, see MosaicFolderFormatDetector); Generate Mosaic below is
             still what actually kicks off processing. -->
        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="7"
                   Text="{Binding DetectedFormatDescription}"
                   FontStyle="Italic" Opacity="0.8" VerticalAlignment="Center"/>

        <!-- Parameters row -->
        <!-- Target FFT Size, Smooth, Smoothing Window and Despike are deliberately NOT
             repeated here - they're mirrored straight from the Single Capture tab (see
             VisualiseViewModel's On...Changed partials and MosaicViewModel.TargetFftSize's
             remarks), so the workflow is: dial those in on Single Capture until a file looks
             right, then Generate Mosaic reprocesses every position in the session with those
             same settings, rather than keeping a second copy of each control in sync by hand. -->
        <TextBlock Grid.Row="8" Grid.Column="0" Text="Integrated Window (km/s)" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBox Grid.Row="8" Grid.Column="2" Width="60" Text="{Binding IntegratedWindowKmPerSec}" VerticalAlignment="Center"/>

        <TextBlock Grid.Row="8" Grid.Column="4" Text="Sky Cell Size (°)" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,5,0"
                       ToolTip="Should match the sweep's own step size, in degrees, so each pixel is one real sky cell"/>
        <TextBox Grid.Row="8" Grid.Column="6" Width="60" Text="{Binding SkyCellSizeDeg}" VerticalAlignment="Center"/>

        <TextBlock Grid.Row="8" Grid.Column="8" Text="{Binding StatusSummary}" VerticalAlignment="Center" Margin="15,0,0,0" FontStyle="Italic"/>

        <Button Grid.Row="8" Grid.Column="12"  Content="Generate Mosaic" Command="{Binding GenerateMosaicCommand}"
                    Visibility="{Binding IsGenerating, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    Padding="10,4"  Width="160"/>

        <!-- Replaces Generate Mosaic while a session is being processed - the button
                 itself is the progress indicator (a green scrolling ProgressBar behind the
                 "Cancel Mosaic" caption), same pattern as Visualise's Cancel button, and
                 clicking it cancels processing. -->
        <Button Grid.Row="8" Grid.Column="12"
                Command="{Binding CancelMosaicCommand}"
                    Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}"
                    ToolTip="{Binding GenerationStatus, StringFormat='Cancel mosaic processing ({0})'}"
                    Padding="10,4" Width="160" Height="25.96">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ProgressBar Minimum="0" Maximum="1"
                                 Value="{Binding GenerationProgress}"
                                 IsHitTestVisible="False"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
            <TextBlock Text="Cancel Mosaic" FontWeight="Bold"/>
        </Button>

        <!-- Shared by both the Zenith Dome and 3D Dome tabs, which both depend on the same
                 live Az/El snapshot (MosaicViewModel.DomeTimeUtc / ComputeVisibleDomePositions) -
                 sits above the TabControl rather than inside either tab so switching between them
                 doesn't lose sight of (or duplicate) the control. Defaults to "now"; editable so
                 you can also see what the sky looked like at an arbitrary moment. -->
        <TextBlock Grid.Row="10" Grid.Column="0" Text="Time (UTC)" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <TextBox Grid.Row="10" Grid.Column="2" Grid.ColumnSpan="4" Width="150" VerticalAlignment="Center"
                         Text="{Binding DomeTimeUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
        <Button Grid.Row="10" Grid.Column="6" Content="Now" Command="{Binding SetDomeTimeNowCommand}"
                        Padding="10,2" Margin="8,0,0,0"/>
        <TextBlock Grid.Row="10" Grid.Column="8" Grid.ColumnSpan="3" Text="(applies to the Zenith Dome and 3D Dome tabs)"
                           FontStyle="Italic" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>

        <!-- Results -->
        <Grid Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <TabControl Grid.Row="0" Grid.Column="0">
                <TabItem Header="Sky Mosaic">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Viewbox Grid.Row="0" Stretch="Uniform">
                            <!-- Axis-label column/row sized in Auto so they hug the plot's own
                                 PixelWidth/PixelHeight - the plot cell (Row 0/Col 1) fixes both
                                 via explicit Width/Height, and the label strips (Row 1/Col 0)
                                 mirror that through Grid's own shared row-height/column-width,
                                 so every tick's pixel Position lines up with the plot beneath it
                                 without any runtime ActualWidth/ActualHeight bindings. -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Dec/Elevation tick labels -->
                                <Canvas Grid.Row="0" Grid.Column="0" Width="34"
                                        Height="{Binding SkyHeatmap.PixelHeight}">
                                    <ItemsControl ItemsSource="{Binding SkyHeatmap.YTickLabels}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <!-- Canvas.Left/Top/Right only take effect on a DIRECT
                                             child of a Canvas - the ItemsPanel Canvas's actual
                                             direct children are the auto-generated item
                                             containers (ContentPresenter), not the TextBlock
                                             inside the DataTemplate, so the position has to be
                                             set here via ItemContainerStyle, not on the
                                             TextBlock itself (which silently no-ops, collapsing
                                             every label to the Canvas's own (0,0) origin). -->
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Right" Value="4"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Position}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" FontSize="10"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>

                                <!-- Heatmap plot + faint gridlines, both fixed to the same pixel size -->
                                <Border Grid.Row="0" Grid.Column="1" BorderBrush="Gray" BorderThickness="1">
                                    <Grid Width="{Binding SkyHeatmap.PixelWidth}" Height="{Binding SkyHeatmap.PixelHeight}">
                                        <Image Source="{Binding SkyHeatmap.Image}" Stretch="Fill"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        <ItemsControl ItemsSource="{Binding SkyHeatmap.GridLines}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                          Stroke="#40808080" StrokeThickness="1"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <!-- RA/Azimuth tick labels -->
                                <Canvas Grid.Row="1" Grid.Column="1" Width="{Binding SkyHeatmap.PixelWidth}" Height="18">
                                    <ItemsControl ItemsSource="{Binding SkyHeatmap.XTickLabels}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <!-- See the Dec/Elevation Canvas above for why this has
                                             to be an ItemContainerStyle, not Canvas.Left on the
                                             TextBlock itself. -->
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding Position}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" FontSize="10" Margin="2,2,0,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Grid>
                        </Viewbox>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="{Binding SkyHeatmap.YAxisLabel}" Margin="0,0,15,0"/>
                            <TextBlock Text="{Binding SkyHeatmap.XAxisLabel}"/>
                            <CheckBox Content="Smooth blend" IsChecked="{Binding UseSmoothBlend}"
                                      VerticalAlignment="Center" Margin="25,0,0,0"
                                      ToolTip="Bilinear-interpolate between neighbouring cell centers instead of one flat colour per measured cell"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock Text="{Binding SkyHeatmap.LegendMinText}" VerticalAlignment="Center"/>
                            <Image Source="{Binding SkyHeatmap.LegendImage}" Width="200" Height="14" Margin="6,0,6,0"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <TextBlock Text="{Binding SkyHeatmap.LegendMaxText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Zenith Dome">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Time (UTC) now lives above the TabControl (shared with the 3D Dome
                             tab, which depends on the same live Az/El snapshot) - see the Results
                             Grid above. Row 0 here is deliberately left empty rather than
                             renumbering every other row below it. -->
                        <!-- A from-here-right-now Alt/Az view (RenderDome) - NOT the same data
                             as the Sky Mosaic tab's persistent RA/Dec canvas above, since an
                             Az/El position is only valid at one instant. -->


                        <Viewbox Grid.Row="1" Stretch="Uniform">
                            <Canvas Width="{Binding SkyDome.CanvasSize}" Height="{Binding SkyDome.CanvasSize}">

                                <!-- Concentric altitude rings, 15deg apart - the outermost (El=0) is the horizon. -->
                                <ItemsControl ItemsSource="{Binding SkyDome.AltitudeRings}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="{Binding Diameter}" Height="{Binding Diameter}"
                                                     Stroke="#40808080" StrokeThickness="1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Azimuth spokes, every 30deg, from the zenith out to the horizon. -->
                                <ItemsControl ItemsSource="{Binding SkyDome.AzimuthSpokes}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                  Stroke="#30808080" StrokeThickness="1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Compass rose labels (N/NE/E/SE/S/SW/W/NW) - E left, W right, matching
                                     how the sky's own dome looks from underneath (see RenderDome's remarks),
                                     not a ground map. -->
                                <ItemsControl ItemsSource="{Binding SkyDome.CompassLabels}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" FontSize="11" FontWeight="Bold"
                                                       Margin="-10,-8,0,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- One marker per position currently above the horizon, coloured by
                                     LineStrengthDb the same ramp the 2D heatmap uses. -->
                                <ItemsControl ItemsSource="{Binding SkyDome.Markers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="9" Height="9" Margin="-4.5,-4.5,0,0"
                                                     Stroke="Black" StrokeThickness="0.5"
                                                     ToolTip="{Binding Tooltip}">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="{Binding Color}"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Viewbox>

                        <TextBlock Grid.Row="2" Text="{Binding SkyDome.StatusText}"
                                   HorizontalAlignment="Center" FontStyle="Italic" Margin="0,4,0,0"/>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,6">
                            <TextBlock Text="{Binding SkyDome.LegendMinText}" VerticalAlignment="Center"/>
                            <Image Source="{Binding SkyDome.LegendImage}" Width="200" Height="14" Margin="6,0,6,0"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <TextBlock Text="{Binding SkyDome.LegendMaxText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="3D Dome">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <views:MosaicDomeSurfaceView Grid.Row="0"
                                                  Points="{Binding SurfacePoints}"
                                                  FitMesh="{Binding FitMeshThroughPoints}"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="Height:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <RadioButton Content="Strength (dB)" GroupName="SurfaceMetric" VerticalAlignment="Center" Margin="0,0,10,0"
                                         IsChecked="{Binding SurfaceMetric, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Strength}"/>
                            <RadioButton Content="Velocity (km/s)" GroupName="SurfaceMetric" VerticalAlignment="Center" Margin="0,0,10,0"
                                         IsChecked="{Binding SurfaceMetric, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Velocity}"/>
                            <CheckBox Content="Fit mesh through points" IsChecked="{Binding FitMeshThroughPoints}"
                                      VerticalAlignment="Center" Margin="25,0,0,0"
                                      ToolTip="Replace the individual stems/dots with a translucent surface triangulated through each point's own extruded center"/>
                            <TextBlock Text="(drag to orbit, scroll to zoom; axis labels read best from the ViewCube's &quot;Top&quot; view)"
                                       FontStyle="Italic" Foreground="Gray" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,6">
                            <TextBlock Text="{Binding SurfaceLegendMinText}" VerticalAlignment="Center"/>
                            <TextBlock Text=" → " VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SurfaceLegendMaxText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
            
            <GridSplitter Grid.Row="0" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            
            <DataGrid Grid.Row="0" Grid.Column="2" ItemsSource="{Binding Positions}" 
                      AutoGenerateColumns="False" 
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Position" Binding="{Binding Label}" Width="Auto"/>
                    <DataGridTextColumn Header="Coordinates" Binding="{Binding Coordinates}" Width="Auto"/>
                    <DataGridTextColumn Header="Line Strength" Binding="{Binding LineStrengthDb, StringFormat=F1}" Width="Auto"/>
                    <DataGridTextColumn Header="Velocity (km/s)" Binding="{Binding PeakVelocityKmPerSec, StringFormat=F1}" Width="Auto"/>
                    <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
