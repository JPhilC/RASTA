<UserControl x:Class="RASTA.App.Views.ProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="10">
        <StackPanel>

            <TextBlock Text="Process (Spectral Processing)"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0 0 0 20"/>

            <Button Content="Process Observations"
                    Width="220"
                    Height="40"
                    Command="{Binding ProcessCommand}"/>

            <TextBlock Text="Processed Count:"
                       FontWeight="Bold"
                       Margin="0 20 0 5"/>

            <TextBlock Text="{Binding Processed.Count}"/>

        </StackPanel>
    </Grid>
</UserControl>
