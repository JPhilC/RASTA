<UserControl x:Class="RASTA.App.Views.VisualiseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:RASTA.App.Views"
             xmlns:helpers="clr-namespace:RASTA.App.Helpers"
             xmlns:controls="clr-namespace:RASTA.App.Controls"
             mc:Ignorable="d">

    <TabControl>
        <TabItem Header="Single Capture">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Label -->
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Entry/Textbox-->
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Label -->
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Entry/Textbox-->
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Label -->
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Entry/Textbox-->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Button-->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Caption-->
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Grid.ColumnSpan="6" 
                       Text="Visualisation"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0 0 0 10"/>

                <TextBlock Grid.Column="0" Grid.Row="2" 
                   VerticalAlignment="Center"
                    Text="Baseline File" FontWeight="Bold" />
                <TextBox Grid.Column="2" Grid.Row="2" Grid.ColumnSpan="9" 
                 VerticalAlignment="Center"
                 Text="{Binding BaselineFile, Mode=OneWay}" MinWidth="300"
                 HorizontalAlignment="Left" IsReadOnly="True" Margin="0,0,5,0"/>
                <Button Grid.Column="12" Grid.Row="2"
            Content="Select Baseline FIT"
            Command="{Binding SelectBaselineFileCommand}"
            Visibility="{Binding BaselineAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
            Padding="10,4"
            Width="160"/>
                <Button Grid.Column="12" Grid.Row="2"
            Content="Clear Baseline FIT"
            Command="{Binding ClearBaselineFileCommand}"
            Visibility="{Binding BaselineAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
            Padding="10,4"
            Width="160"/>

                <TextBlock Grid.Column="0" Grid.Row="4" 
            Text="Capture File" FontWeight="Bold" />
                <TextBox Grid.Column="2" Grid.Row="4" Grid.ColumnSpan="9" MinWidth="300" 
                 VerticalAlignment="Center"
                 Text="{Binding CaptureFile, Mode=OneWay}" HorizontalAlignment="Left" IsReadOnly="True" Margin="0,0,5,0"/>
                <Button Grid.Column="12" Grid.Row="4"
            Content="Select Capture FIT"
            Command="{Binding SelectCaptureFileCommand}"
            Visibility="{Binding CaptureAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
            Padding="10,4"
            Width="160"/>
                <Button Grid.Column="12" Grid.Row="4"
            Content="Clear Capture FIT"
            Command="{Binding ClearCaptureFileCommand}"
            Visibility="{Binding CaptureAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
            Padding="10,4"
            Width="160"/>

                <TextBlock Grid.Column="0" Grid.Row="6" 
            Text="Spectrum Mode" FontWeight="Bold" />

                <ComboBox Grid.Column="2" Grid.Row="6"  Width="180" 
                  HorizontalAlignment="Left"
                  ItemsSource="{Binding Source={x:Static helpers:SpectrumModeValues.All}}"
                  SelectedValue="{Binding Mode, Mode=TwoWay}"
                  SelectedValuePath="Mode"
                  DisplayMemberPath="Name" />



                <TextBlock Grid.Column="4" Grid.Row="6" 
            Text="Target FFT Size" FontWeight="Bold" />

                <TextBox Grid.Column="6" Grid.Row="6" Width="50"
                     Text="{Binding TargetFftSize}" HorizontalAlignment="Left"/>

                <CheckBox Grid.Column="8" Grid.Row="6"
                  VerticalAlignment="Center"
                  Content="Show dB (baseline/capture/ratio only)"
                  IsChecked="{Binding UseDbScale}"/>


                <Button Grid.Column="14" Grid.Row="6"
            Content="Generate Chart"
            Command="{Binding GenerateChartCommand}"
            Padding="10,4"
            Width="160"/>

                <TextBlock Grid.Column="0" Grid.Row="8"
                       Text="Smooth" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Grid.Column="2" Grid.Row="8"
                HorizontalAlignment="Left" Width="140"
                      ItemsSource="{Binding Source={x:Static helpers:SmoothingKindValues.All}}"
                      SelectedValue="{Binding SmoothingKind, Mode=TwoWay}"
                      SelectedValuePath="Kind"
                      DisplayMemberPath="Name"/>
                <TextBlock Grid.Column="4" Grid.Row="8" 
                   HorizontalAlignment="Left"
                   Text="Window" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <TextBox Grid.Column="6" Grid.Row="8" Width="40" 
                 HorizontalAlignment="Left"
                 Text="{Binding SmoothingWindow}"
                     ToolTip="Smoothing window width, in FFT bins (odd numbers only - even values are rounded up)"/>

                <Grid Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Centre  -->
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Entry/Textbox-->
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Button-->
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                       Text="Frequency (Hz)" FontWeight="Bold" />
                    <controls:FrequencyEntryBox Grid.Column="2"  
                                        FrequencyHz="{Binding FrequencyHz, Mode=OneWay}" HorizontalAlignment="Left" IsReadOnly="True"/>

                    <TextBlock Grid.Column="4" VerticalAlignment="Center"
                       Text="Sampling (Hz)" FontWeight="Bold" />
                    <controls:FrequencyEntryBox Grid.Column="6"  
                                        FrequencyHz="{Binding SamplingHz, Mode=OneWay}" HorizontalAlignment="Left" IsReadOnly="True"/>

                    <TextBlock Grid.Column="8" VerticalAlignment="Center"
                       Text="Gain (dB)" FontWeight="Bold" />
                    <TextBox Grid.Column="10"  Width="50"
                     Text="{Binding Gain, Mode=OneWay}" HorizontalAlignment="Left" IsReadOnly="True"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                       Text="Frames" FontWeight="Bold" />
                    <TextBox Grid.Row="2" Grid.Column="2"  Width="100"
                     Text="{Binding FrameCount, Mode=OneWay}" HorizontalAlignment="Left" IsReadOnly="True"/>

                    <TextBlock Grid.Row="2" Grid.Column="4" VerticalAlignment="Center"
                       Text="LSR Correction" FontWeight="Bold" />

                    <TextBox Grid.Row="2" Grid.Column="6"  Width="100"
                     Text="{Binding LsrInfo, Mode=OneWay}" HorizontalAlignment="Left" IsReadOnly="True"/>

                    <TextBlock Grid.Row="2" Grid.Column="8" VerticalAlignment="Center"
                       Text="Files Combined" FontWeight="Bold" />
                    <TextBox Grid.Row="2" Grid.Column="10"  Width="50"
                     Text="{Binding CombinedFileCount, Mode=OneWay}" HorizontalAlignment="Left" IsReadOnly="True"/>
                </Grid>

                <views:SpectrumView
            Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="13"
            Margin="0,10,0,0"
            DataContext="{Binding SpectrumVm}"/>
            </Grid>
        </TabItem>
        <TabItem Header="Mosaic">
            <views:MosaicView DataContext="{Binding MosaicVm}"/>
        </TabItem>
    </TabControl>
</UserControl>
