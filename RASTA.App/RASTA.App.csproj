<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>RASTA.App.App</StartupObject>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationIcon>Assets\Rasta.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SDK's implicit default-items glob would otherwise also include these two files as
         <None>, alongside their explicit Resource/SplashScreen entries below - two item types for
         the same file trips up WPF's resource generation ("An item with the same key has already
         been added", RG1000). Visual Studio pairs a Remove like this automatically when you set a
         file's Build Action through the Properties window; it's required by hand here since these
         were added by editing the csproj directly. -->
    <None Remove="Assets\ButtonBarFooter.png" />
    <None Remove="Assets\Rasta.ico" />
    <None Remove="Assets\RastaSplash.png" />
    <Resource Include="Assets\ButtonBarFooter.png" />

    <Resource Include="Assets\Rasta.ico" />
    <!-- NOT the SplashScreen build action: that renders via a native GDI call before WPF's own
         rendering pipeline loads (which is what makes it appear instantly), and that path ignores
         PNG alpha entirely - transparent pixels always paint white. SplashWindow.xaml, a real
         AllowsTransparency WPF window shown manually from App.OnStartup, is what actually honors
         this image's transparency. -->
    <Resource Include="Assets\RastaSplash.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RASTA.Core\RASTA.Core.csproj" />
    <ProjectReference Include="..\RASTA.Infrastructure\RASTA.Infrastructure.csproj" />
    <ProjectReference Include="..\RASTA.Processing\RASTA.Processing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\UserOptionsView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

</Project>
