<Window x:Class="RASTA.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RASTA.App"
        xmlns:views="clr-namespace:RASTA.App.Views"
        mc:Ignorable="d"
        Title="R.A.S.T.A."
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="NavButtonBaseStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="BorderBrush" Value="#2D2D2D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="16"/>
            <!-- Flat template of our own, so disabled buttons dim (Opacity) instead of
                 the default OS button chrome taking over and painting a bright/light-gray
                 disabled look that stands out more than the enabled or selected buttons -
                 setting Background/Foreground alone doesn't override that default chrome. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <StackPanel Grid.Column="0" Grid.Row="0"
                    Background="#1E1E1E"
                    Margin="10"
                    VerticalAlignment="Stretch">

            <TextBlock Text="R.A.S.T.A."
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="10,10,10,0"/>
            <TextBlock Text="Radio Astronomy Slew Track Acquire"
                       Foreground="White"
                       FontSize="10"
                       FontWeight="Bold"
                       Margin="10,5"/>

            <Button Content="Prepare"
                    Margin="5"
                    Padding="10"
                    Command="{Binding NavigatePrepareCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource NavButtonBaseStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="Prepare">
                                <Setter Property="Background" Value="#444"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#4FC3F7"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Plan"
                    Margin="5"
                    Padding="10"
                    Command="{Binding NavigatePlanCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource NavButtonBaseStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="Plan">
                                <Setter Property="Background" Value="#444"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#4FC3F7"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Capture"
                    Margin="5"
                    Padding="10"
                    Command="{Binding NavigateCaptureCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource NavButtonBaseStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="Capture">
                                <Setter Property="Background" Value="#444"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#4FC3F7"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>


            <Button Content="Visualise"
                    Margin="5"
                    Padding="10"
                    Command="{Binding NavigateVisualiseCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource NavButtonBaseStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="Visualise">
                                <Setter Property="Background" Value="#444"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#4FC3F7"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Options" VerticalAlignment="Bottom"
                    Margin="5,50,5,5"
                    Padding="10"
                    Command="{Binding NavigateUserOptionsCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource NavButtonBaseStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="Options">
                                <Setter Property="Background" Value="#444"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#4FC3F7"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <Image Margin="10"
               VerticalAlignment="Bottom"
               Source="/Assets/ButtonBarFooter.png"/>

        <!-- Main Content -->
        <ContentControl Grid.Column="1" Grid.Row="0"
                        Content="{Binding CurrentViewModel}"
                        Margin="10"/>

        <!-- Status Bar -->
        <views:StatusBar Grid.ColumnSpan="2"
                     Grid.Row="1"
                     DataContext="{Binding StatusBarViewModel}"/>
    </Grid>
</Window>
