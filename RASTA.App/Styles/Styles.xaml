<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:RASTA.App.Controls">

    <!-- The nav sidebar's own "selected section" accent colour (MainWindow.xaml's Prepare/Plan/
         Capture/Visualise/Options buttons) - shared here so anything elsewhere in the app that
         wants to visually agree with "this is the selected/current thing" (e.g. MosaicView's
         Positions DataGrid selected-row colour) can reference the same colour instead of a second
         hardcoded hex copy that could drift out of sync. Kept as a Color (not just a Brush) since
         a SystemColors brush-key override needs a Color-typed source, not a Brush one.-->
    <Color x:Key="NavSelectedAccentColor">#4FC3F7</Color>
    <SolidColorBrush x:Key="NavSelectedAccentBrush" Color="{StaticResource NavSelectedAccentColor}"/>

    <!-- Default template for ZoomAndPanControl: a clipped Border hosting the
         ContentPresenter the control's code-behind looks up as "PART_Content" and
         applies its Scale/Translate render transform to. Background must stay
         hit-test-visible (Transparent, not null) so wheel/drag input registers over
         the empty space around whatever content is wrapped, not just over the content
         itself. -->
    <Style TargetType="{x:Type controls:ZoomAndPanControl}">
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZoomAndPanControl}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            ClipToBounds="True">
                        <ContentPresenter x:Name="PART_Content"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top"
                                          RenderTransformOrigin="0,0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Implicit style (no x:Key) so every plain-string tooltip in the app
         (ToolTip="some long explanation...") wraps into a sensibly-sized box instead of
         spanning the whole window unwrapped - WPF's default ToolTip template doesn't wrap
         text on its own, it just sizes to content. ContentTemplate's {Binding} resolves to
         the ToolTip's own Content (the string set via the shorthand ToolTip="..." syntax).
         TextBlock does honor literal newlines (the &#x0a; entities used in some tooltips)
         as line breaks even with TextWrapping set, so paragraph breaks still render. -->
    <Style TargetType="ToolTip">
        <Setter Property="MaxWidth" Value="480"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>