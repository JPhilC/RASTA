<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:RASTA.App.ViewModels"
                    xmlns:views="clr-namespace:RASTA.App.Views">

    <!-- Prepare -->
    <DataTemplate DataType="{x:Type vm:PrepareViewModel}">
        <views:PrepareView/>
    </DataTemplate>

    <!-- Plan -->
    <DataTemplate DataType="{x:Type vm:PlanViewModel}">
        <views:PlanView/>
    </DataTemplate>

    <!-- Observe -->
    <DataTemplate DataType="{x:Type vm:ObserveViewModel}">
        <views:ObserveView/>
    </DataTemplate>

    <!-- Process -->
    <DataTemplate DataType="{x:Type vm:ProcessViewModel}">
        <views:ProcessView/>
    </DataTemplate>

    <!-- Visualise -->
    <DataTemplate DataType="{x:Type vm:VisualiseViewModel}">
        <views:VisualiseView/>
    </DataTemplate>

    <!-- User Options -->
    <DataTemplate DataType="{x:Type vm:UserOptionsViewModel}">
        <views:UserOptionsView/>
    </DataTemplate>

</ResourceDictionary>
