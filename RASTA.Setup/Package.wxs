<!-- MSI package for RASTA.App. Files are harvested straight from the dotnet publish output
     (see PublishRastaApp target in RASTA.Setup.wixproj) via the wildcard <Files> element -
     no heat.exe / manual file list to keep in sync. This package is framework-dependent: it
     does not carry the .NET runtime itself. RASTA.Bundle.wixproj chains this MSI together with
     the .NET 10 Desktop Runtime installer into a single setup.exe. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="R.A.S.T.A."
           Manufacturer="JPhilC"
           Version="$(var.RastaVersion)"
           UpgradeCode="FB60AC3B-C825-408B-B029-1A8A99E7F4BB"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of R.A.S.T.A. is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="RastaIcon.exe" SourceFile="$(var.PublishDir)RASTA.App.exe" />
    <Property Id="ARPPRODUCTICON" Value="RastaIcon.exe" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RASTA" FileSource="$(var.PublishDir)">
        <!-- Harvests every file dotnet publish produced (RASTA.App.exe, its dependency DLLs,
             the native RTL-SDR/libusb DLLs RASTA.Infrastructure ships - see CLAUDE.md). Falls
             into the implicit default Feature along with the shortcut Component below. -->
        <Files Include="**" />

        <Component Id="ApplicationShortcut">
          <Shortcut Id="StartMenuShortcut"
                     Name="R.A.S.T.A."
                     Directory="ProgramMenuFolder"
                     WorkingDirectory="INSTALLFOLDER"
                     Icon="RastaIcon.exe"
                     Target="[INSTALLFOLDER]RASTA.App.exe" />
          <RemoveFolder Id="RemoveProgramMenuFolder" Directory="ProgramMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\JPhilC\RASTA" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

  </Package>
</Wix>
